{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Discord Quest Completer",
  "version": "25.4.18",
  "identifier": "me.markterence.discordquestcompleter",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Discord Quest Completer",
        "width": 1180,
        "height": 680,
        "minWidth": 1024,
        "minHeight": 600,
        "center": true,
        "transparent": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": []
      },
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost https://github.com https://objects.githubusercontent.com", 
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "style-src": "'unsafe-inline' 'self'"
      }
    }
  }, 
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/src-win.exe": "data/src-win.exe"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFEMUZFQUVGNTRDNEZENEQKUldSTi9jUlU3K29mSFhnWmVpRk5jeWxaL1lRQThJM29KcStTWHFPWHEwTmhaOXJVY0p1M01zYmcK",
      "endpoints": [
        "https://github.com/volk-xp/Discord-quest-completer-by-Volk/releases/latest/download/latest.json"
      ]
    }
  }
}
